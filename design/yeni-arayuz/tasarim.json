  "elevation": {
    "e0": {
      "dark": "border 1 border",
      "light": "border 1 border"
    },
    "e1": {
      "dark": "surface + border + topHighlight(inset 0 1)",
      "light": "surface + border + shadow 0 1 2 #3C280A0A"
    },
    "e2": {
      "dark": "surfaceRaised + borderStrong + shadow 0 18 44 -12 #00000099",
      "light": "surfaceRaised + border + shadow 0 16 36 -14 #3C280A38"
    },
    "e3": {
      "dark": "glass + blur 24 + saturate 1.4 + glassBorder",
      "light": "glass + blur 24 + saturate 1.4 + glassBorder",
      "kullanim": "yalnız sekme çubuğu, sheet, perde hapları"
    }
  },
  "effect": {
    "glowPrimary": {
      "shadow": "0 10 28 -8 amberGlow",
      "inner": "inset 0 1 0 #FFFFFF73",
      "gradient": [
        "amberHover",
        "amber"
      ]
    },
    "focusRing": {
      "gap": 2,
      "width": 2,
      "color": "amber",
