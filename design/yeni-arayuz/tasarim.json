    "coverGlow": {
      "blur": 26,
      "opacity": 0.55,
      "inset": "14% 8% -8% 8%",
      "kaynak": "kapak baskın rengi, önceden hesaplanır"
    },
    "livePulse": {
      "color": "liveDot",
      "period": 1600,
      "ring": 6
    },
    "sheen": {
      "period": 1800,
      "yalnizIlerlemeSurerken": true
    },
    "celebrate": {
      "rays": "conic 8°/24°",
      "rayRotate": 12000,
      "checkSpring": [
        0.34,
        1.56,
        0.64,
        1
      ],
      "duration": 600,
      "haptic": "success"
    },
    "searchRings": {
      "count": 3,
      "period": 2400,
      "stagger": 800
    },
    "barsLoader": {
      "period": 1200,
      "kaynak": "logodaki iki amber altyazı çubuğu"
    }
