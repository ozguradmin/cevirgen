      "color": "amber",
      "alpha": {
        "dark": 0.16,
        "light": 0.22
      },
      "animated": false
    },
    "ambientBlobs": {
      "colors": [
        "amber",
        "peach",
        "sky"
      ],
      "period": 24000,
      "maxFps": 15,
      "yalnizBosta": true
