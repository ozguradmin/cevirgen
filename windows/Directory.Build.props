<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <Company>Çevirgen</Company>
    <Product>Çevirgen</Product>
    <Copyright>AGPL-3.0. Based on CouchSubs (Sinan Yorulmaz). Uses chiaki-ng (AGPL-3.0).</Copyright>
    <!-- WPF projesi Windows dışında da derlenebilsin (çalıştırmak için Windows gerekir). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
