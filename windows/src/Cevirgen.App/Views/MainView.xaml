<!-- Canlı (taslak: design/cevirgen/arayuz-taslagi/Main.dc.html): yayın monitörü önde. Solda oyunun adı ve TV durumu, ilk
     bakışta tam boy 16:9 TV önizlemesi (son kare + TV'deki Türkçe satırlar, kullanıcının gerçek görünümüyle), altında tek
     satır sayılar (gecikme, ortalama okuma hızı / 17, görünüm bağlantısı, "Alanları düzenle", gizle kısayolu). Bildirimler
     başlığın altında tek şeritte (en önemlisi; diğerleri "+N uyarı daha"). Sağda kendi içinde kayan döküm: zaman kodu, İngilizce (gri), Türkçe; ekrandaki
     satırlar "● ekranda" sarı, hızlı satırlar turuncu. Çeviri kapalıyken önizlemenin üstünde büyük "Çeviriyi başlat" ve bağlı
     olanlar. Oyun sorulunca "Hangi Oyun?" kartı ekranın üstünde açılır. -->
<UserControl x:Class="Cevirgen.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cevirgen.App.Controls"
             xmlns:t="clr-namespace:Cevirgen.App.Theme"
             xmlns:local="clr-namespace:Cevirgen.App.Views"
             xmlns:s="clr-namespace:Cevirgen.App.Views.Steps">
    <Grid>
    <Grid x:Name="Body">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition x:Name="AsideColumn" Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ───── TV görüntüsü ───── -->
        <Grid x:Name="Stage" Margin="{t:Sp 'edge,m'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Margin="{t:Sp '0,0,0,s'}" LastChildFill="True">
                <!-- Ekranı çevir ve deneme altyazısı (kısayolu ipucunda). -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ScreenButton" Style="{StaticResource OutlineButton}" Content="Ekranı çevir" Click="OnTranslateScreen"
                            Margin="{t:Sp 'xs,0,0,0'}" />
                    <Button x:Name="TestButton" Click="OnTest" Margin="{t:Sp 'xs,0,0,0'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Setter Property="Content" Value="Ekranda dene" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsOnTv}" Value="True">
                                        <Setter Property="Content" Value="TV'de dene" />
                                    </DataTrigger>
                                    <!-- TV uygulaması bağlı değilse önce TV'de açılır, bağlanınca deneme altyazısı gider. -->
                                    <DataTrigger Binding="{Binding OpeningTvAppForTest}" Value="True">
                                        <Setter Property="Content" Value="{t:T 'Opening the App on the TV…'}" />
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="t:PerdeProps.Busy" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GameTitle" Style="{StaticResource ScreenTitle}" FontSize="22" Margin="{t:Sp '0,0,m,0'}" VerticalAlignment="Bottom"
                               AutomationProperties.HeadingLevel="Level1" />
                    <Button x:Name="GameChangeButton" Style="{StaticResource TextLink}" Click="OnChangeGame" Margin="{t:Sp '0,0,m,0'}" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="TvMeta" FontSize="13" Foreground="{DynamicResource mutedBrush}" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="{t:Sp '0,0,0,xxs'}" />
                </WrapPanel>
            </DockPanel>

            <!-- Bildirim şeridi: en önemli bildirim tek satırda, önizlemenin üstünde (MainView.ShowNotices; sıra Shell'de,
                 LiveNotices). Yoksa görünmez. -->
            <local:NoticeStrip x:Name="Strip" Grid.Row="1" Margin="{t:Sp '0,0,0,s'}" />

            <!-- Önizleme kalan yüksekliğe sığar; sayılar hemen altında (MainView.FitPreview). -->
            <Grid x:Name="StageArea" Grid.Row="2">
            <StackPanel VerticalAlignment="Top">
            <local:LivePreview x:Name="Preview" />

            <!-- Tek satır sayılar ve kısayol ipucu. -->
            <DockPanel x:Name="StatsRow" Margin="{t:Sp '0,s,0,0'}" LastChildFill="False">
                <StackPanel x:Name="HideHint" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="HideKeys" Orientation="Horizontal" />
                    <TextBlock Text="altyazıyı gizle" FontSize="13" Foreground="{DynamicResource mutedBrush}" VerticalAlignment="Center" Margin="{t:Sp 'xxs,0,0,0'}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- Çevirgen: alan düzenleme sık kullanılır; metin bağlantısı gözden kaçıyordu, çerçeveli düğme oldu. -->
                    <Button Style="{StaticResource SmallSecondaryButton}" Click="OnEditAreas" Height="32" MinHeight="32" Padding="{t:Sp 's,0'}"
                            Margin="{t:Sp '0,0,l,0'}" VerticalAlignment="Center" ToolTip="Okunan alanları son karenin üstünde sürükleyip büyüt"
                            AutomationProperties.Name="Alanları düzenle">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7A8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{DynamicResource amberTextBrush}" VerticalAlignment="Center" Margin="{t:Sp '0,0,xs,0'}" />
                            <TextBlock Text="Alanları düzenle" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock FontSize="13" Foreground="{DynamicResource mutedBrush}" VerticalAlignment="Center" Margin="{t:Sp '0,0,l,0'}">
                        <Run Text="Gecikme" /> <Run x:Name="DelayValue" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource textBrush}" />
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{DynamicResource mutedBrush}" VerticalAlignment="Center" Margin="{t:Sp '0,0,l,0'}">
                        <Run Text="Okuma hızı ort." /> <Run x:Name="SpeedValue" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource textBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{t:Sp '0,0,l,0'}">
                        <TextBlock Text="Görünüm" FontSize="13" Foreground="{DynamicResource mutedBrush}" VerticalAlignment="Center" Margin="{t:Sp '0,0,xxs,0'}" />
                        <Button x:Name="LookLink" Style="{StaticResource TextLink}" Click="OnLook" />
                    </StackPanel>
                </WrapPanel>
            </DockPanel>
            </StackPanel>
            </Grid>

        </Grid>

        <!-- ───── Döküm ───── -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource borderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="{t:Sp 'cue,m,cue,s'}">
                    <TextBlock x:Name="FeedCount" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource mutedBrush}" TextWrapping="NoWrap" VerticalAlignment="Bottom" />
                    <TextBlock Text="Döküm" Style="{StaticResource MonoLabel}" VerticalAlignment="Bottom" AutomationProperties.HeadingLevel="Level2" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource LinkButton}" Click="OnHistory" Margin="{t:Sp 'cue,item'}" HorizontalAlignment="Left"
                            Content="Tüm geçmiş ve düzeltmeler →" FocusVisualStyle="{StaticResource FocusRing}" />
                </Border>
                <!-- Destek alanı: çeviri 20 satır çevirdikten sonra, hata bildirimi yokken; tek satır ve çerçeveli düğme (sarı
                     değil). Kapatılamaz; önizlemeyi ve şeridi itmez (dökümün altında). Metin sunucudan değişebilir. -->
                <Border x:Name="SupportRow" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0"
                        Padding="{t:Sp 'cue,s'}" Visibility="Collapsed">
                    <DockPanel>
                        <Image x:Name="SupportIcon" DockPanel.Dock="Left" Width="20" Height="20" Margin="{t:Sp '0,0,s,0'}" VerticalAlignment="Center"
                               Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Button x:Name="SupportButton" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" MinHeight="32" Margin="{t:Sp 's,0,0,0'}"
                                VerticalAlignment="Center" Click="OnSupport" />
                        <TextBlock x:Name="SupportText" FontSize="13" Foreground="{DynamicResource mutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <Grid>
                    <TextBlock x:Name="FeedEmpty" Style="{StaticResource HintText}" Margin="{t:Sp 'cue,s'}"
                               Text="Çeviri başlayınca satırlar burada akar: İngilizcesi, Türkçesi ve nereden geldiği." />
                    <ScrollViewer x:Name="FeedScroll" Style="{StaticResource CardScroll}">
                        <ItemsControl x:Name="Feed" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Cue" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="{t:Sp 'cue,s'}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="Label" DockPanel.Dock="Right" Text="{Binding Label}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource mutedBrush}" TextWrapping="NoWrap" />
                                                <TextBlock x:Name="Time" Text="{Binding Timecode}" Style="{StaticResource Timecode}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding English}" FontSize="13" Foreground="{DynamicResource mutedBrush}" TextWrapping="Wrap" Margin="{t:Sp '0,xxs,0,0'}" />
                                            <TextBlock x:Name="Turkish" Text="{Binding Turkish}" FontSize="15" Foreground="{DynamicResource textBrush}" TextWrapping="Wrap"
                                                       Margin="{t:Sp '0,line,0,0'}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding OnScreen}" Value="True">
                                            <Setter TargetName="Cue" Property="Background" Value="{DynamicResource surfaceBrush}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource amberTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                            <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource amberTextBrush}" />
                                            <Setter TargetName="Turkish" Property="Foreground" Value="{DynamicResource amberTextBrush}" />
                                            <Setter TargetName="Turkish" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Fast">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource warnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Yours">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource textBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>

        <!-- "Hangi oyunu oynuyorsun?": ana ekran soluklaşır, ortada aranabilir karo ızgarası (GamePickerView; kod içinde kurulur). -->
        <Grid x:Name="GameAsk" Visibility="Collapsed" Background="{DynamicResource scrimBrush}" Margin="0" />
    </Grid>
</UserControl>
