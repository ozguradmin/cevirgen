<!-- İkinci PlayStation hesabıyla giriş (Mac PSNLoginStep) ve altında ikinci hesabın nasıl açılacağı: tek hesap kartı. Girişliyse yeşil nokta + "Giriş yapıldı" ve sağda küçük
     "Yeniden Giriş Yap"; değilse tek ana "Giriş Yap". Tarayıcıda giriş ve hesap kimliğini elle girme "Diğer Giriş Yolları"nda. -->
<UserControl x:Class="Cevirgen.App.Views.Steps.PsnLoginStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Cevirgen.App.Controls"
             xmlns:t="clr-namespace:Cevirgen.App.Theme">
    <c:StepLayout Title="{t:T 'Second PlayStation Account'}"
                  Message="{t:T 'Çevirgen connects to the PS5 by itself with a second account. You keep playing with your main account.'}">
        <c:SpacedStack Gap="s" MaxWidth="640" HorizontalAlignment="Left">
            <c:AccountCard x:Name="Account" Badge="PS" Title="{t:T 'PlayStation Account'}" SignedIn="{Binding HasAccount, Mode=OneWay}" SignIn="OnSignIn">
                <c:SpacedStack>
                    <!-- Uygulama içi giriş Sony'nin "Can't connect to the server" hatasında kalırsa giriş sistem tarayıcısında yapılır,
                         yönlendirme adresi buraya yapıştırılır (panoya kopyalanınca kendiliğinden alınır). -->
                    <Button x:Name="ShowBrowser" Content="{t:T 'Sign In in the Browser'}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="OnShowBrowser" />
                    <c:SpacedStack x:Name="BrowserPanel" Gap="s" Visibility="Collapsed">
                        <TextBlock x:Name="BrowserReason" Style="{StaticResource HintText}" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="{t:T 'Sony\'s sign-in page could not reach its server inside the app, so sign-in moved to your browser.'}" />
                        <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                   Text="{t:T 'Sign in with your second account in the browser that opened. When you finish, the browser stays on a remoteplay.dl.playstation.net page that only says redirect. Click the address bar, copy the whole address and come back here. Çevirgen picks up the copied address by itself; if it does not, paste it below and press Save.'}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="BrowserUrl" PreviewKeyDown="OnBrowserKeyDown" />
                            <Button Grid.Column="1" Content="{t:T 'Save'}" Style="{StaticResource PrimaryButton}" Margin="{t:Sp 's,0,0,0'}" Click="OnSaveBrowser" />
                        </Grid>
                        <Button Content="{t:T 'Open the Browser Again'}" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnOpenBrowser" />
                        <TextBlock x:Name="BrowserError" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                                   Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIf}}" />
                    </c:SpacedStack>
                    <!-- Sony girişi açılmıyorsa (ör. servis sağlayıcı engelliyor) hesap kimliği elle yazılır. -->
                    <Button x:Name="ShowManual" Content="{t:T 'Enter Account ID Manually'}" Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left" Click="OnShowManual" />
                    <c:Unit x:Name="Manual" Visibility="Collapsed"
                            Hint="{t:T 'If Sony\'s sign-in page does not open (some internet providers block it), enter the second account\'s PSN account ID in base64 (12 characters, e.g. AbCdEfGhIjk=).'}">
                        <c:SpacedStack Gap="xs">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ManualId" MaxLength="24" FontFamily="{StaticResource MonoFont}" PreviewKeyDown="OnManualKeyDown" />
                                <Button Grid.Column="1" Content="{t:T 'Save'}" Style="{StaticResource PrimaryButton}" Margin="{t:Sp 's,0,0,0'}" Click="OnSaveManual" />
                            </Grid>
                            <TextBlock x:Name="ManualError" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIf}}" />
                        </c:SpacedStack>
                    </c:Unit>
                </c:SpacedStack>
            </c:AccountCard>
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" TextWrapping="Wrap"
                       Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource VisibleIf}}" />

            <!-- Çevirgen 1.3: eski "İkinci PlayStation hesabı" adımı buraya katıldı (ayrı adım yok). Tam PS5 menü yollarıyla. -->
            <StackPanel x:Name="SecondAccountHelp" Margin="{t:Sp '0,l,0,0'}"
                        Visibility="{Binding HasAccount, Converter={StaticResource VisibleIf}, ConverterParameter=invert}">
                <TextBlock Text="Henüz ikinci hesabın yok mu? Bir kez yapılır:" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource textBrush}" />
                <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,xs,0,0'}" TextWrapping="Wrap"
                           Text="1. playstation.com'da farklı bir e-posta adresiyle ücretsiz bir hesap aç." />
                <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,0'}" TextWrapping="Wrap"
                           Text="2. PS5'te: PS düğmesi › sağ üstteki profil simgesi › Kullanıcı Değiştir › Kullanıcı Ekle. Yeni hesapla bir kez oturum aç." />
                <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,0'}" TextWrapping="Wrap"
                           Text="3. Yeni kullanıcıdayken: Ayarlar › Sistem › Uzaktan Oynatma › Uzaktan Oynatmayı Etkinleştir'i aç." />
                <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,0'}" TextWrapping="Wrap"
                           Text="4. Kendi kullanıcına dön ve yukarıdan yeni hesapla giriş yap. Oyunu her zaman kendi (ana) hesabınla oyna." />
                <WrapPanel Margin="{t:Sp '0,s,0,0'}">
                    <Button Content="Hesap açma sayfasını aç ↗" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,0,xs,xs'}" Click="OnOpenSignUp" />
                    <Button Content="İkinci hesap açmadan: bilgisayardaki Remote Play penceresini oku" Style="{StaticResource TextLink}" Margin="{t:Sp '0,0,0,xs'}"
                            Click="OnUseRemotePlayWindow" />
                </WrapPanel>
            </StackPanel>
        </c:SpacedStack>
    </c:StepLayout>
</UserControl>
