<!-- Canlı (taslak: design/cevirgen/arayuz-taslagi/Main.dc.html): yayın monitörü önde. Solda oyunun adı ve TV durumu, ilk
     bakışta tam boy 16:9 TV önizlemesi (son kare + TV'deki Türkçe satırlar, kullanıcının gerçek görünümüyle), altında tek
     satır sayılar (gecikme, ortalama okuma hızı / 17, görünüm bağlantısı, "Alanları düzenle", gizle kısayolu) ve yalnız
     yapılacak bir şey varken bildirimler. Sağda kendi içinde kayan döküm: zaman kodu, İngilizce (gri), Türkçe; ekrandaki
     satırlar "● ekranda" sarı, hızlı satırlar turuncu. Çeviri kapalıyken önizlemenin üstünde büyük "Çeviriyi başlat" ve bağlı
     olanlar. Oyun sorulunca "Hangi Oyun?" kartı ekranın üstünde açılır. -->
<UserControl x:Class="CouchSubs.App.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme"
             xmlns:local="clr-namespace:CouchSubs.App.Views"
             xmlns:s="clr-namespace:CouchSubs.App.Views.Steps">
    <Grid>
    <Grid x:Name="Body">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="520" />
            <ColumnDefinition x:Name="AsideColumn" Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ───── TV görüntüsü ───── -->
        <Grid x:Name="Stage" Margin="{t:Sp 'edge,m'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="{t:Sp '0,0,0,s'}" LastChildFill="True">
                <!-- Ekranı çevir ve deneme altyazısı (kısayolu ipucunda). -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ScreenButton" Style="{StaticResource OutlineButton}" Content="Ekranı çevir" Click="OnTranslateScreen"
                            Margin="{t:Sp 'xs,0,0,0'}" />
                    <Button x:Name="TestButton" Click="OnTest" Margin="{t:Sp 'xs,0,0,0'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource OutlineButton}">
                                <Setter Property="Content" Value="Ekranda dene" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsOnTv}" Value="True">
                                        <Setter Property="Content" Value="TV'de dene" />
                                    </DataTrigger>
                                    <!-- TV uygulaması bağlı değilse önce TV'de açılır, bağlanınca deneme altyazısı gider. -->
                                    <DataTrigger Binding="{Binding OpeningTvAppForTest}" Value="True">
                                        <Setter Property="Content" Value="{t:T 'Opening the App on the TV…'}" />
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="t:PerdeProps.Busy" Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock x:Name="GameTitle" Style="{StaticResource ScreenTitle}" FontSize="22" Margin="{t:Sp '0,0,m,0'}" VerticalAlignment="Bottom"
                               AutomationProperties.HeadingLevel="Level1" />
                    <Button x:Name="GameChangeButton" Style="{StaticResource TextLink}" Click="OnChangeGame" Margin="{t:Sp '0,0,m,0'}" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="TvMeta" FontSize="13" Foreground="{DynamicResource mutedBrush}" TextWrapping="NoWrap" VerticalAlignment="Bottom" Margin="{t:Sp '0,0,0,xxs'}" />
                </WrapPanel>
            </DockPanel>

            <!-- Önizleme kalan yüksekliğe sığar; sayılar hemen altında (MainView.FitPreview). -->
            <Grid x:Name="StageArea" Grid.Row="1">
            <StackPanel VerticalAlignment="Top">
            <local:LivePreview x:Name="Preview" />

            <!-- Tek satır sayılar ve kısayol ipucu. -->
            <DockPanel x:Name="StatsRow" Margin="{t:Sp '0,s,0,0'}" LastChildFill="False">
                <StackPanel x:Name="HideHint" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="HideKeys" Orientation="Horizontal" />
                    <TextBlock Text="altyazıyı gizle" FontSize="13" Foreground="{DynamicResource mutedBrush}" VerticalAlignment="Center" Margin="{t:Sp 'xxs,0,0,0'}" />
                </StackPanel>
                <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock FontSize="13" Foreground="{DynamicResource mutedBrush}" VerticalAlignment="Center" Margin="{t:Sp '0,0,l,0'}">
                        <Run Text="Gecikme" /> <Run x:Name="DelayValue" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource textBrush}" />
                    </TextBlock>
                    <TextBlock FontSize="13" Foreground="{DynamicResource mutedBrush}" VerticalAlignment="Center" Margin="{t:Sp '0,0,l,0'}">
                        <Run Text="Okuma hızı ort." /> <Run x:Name="SpeedValue" FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource textBrush}" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{t:Sp '0,0,l,0'}">
                        <TextBlock Text="Görünüm" FontSize="13" Foreground="{DynamicResource mutedBrush}" VerticalAlignment="Center" Margin="{t:Sp '0,0,xxs,0'}" />
                        <Button x:Name="LookLink" Style="{StaticResource TextLink}" Click="OnLook" />
                    </StackPanel>
                    <Button Style="{StaticResource TextLink}" Content="Alanları düzenle" Click="OnEditAreas" Margin="{t:Sp '0,0,l,0'}" />
                </WrapPanel>
            </DockPanel>
            </StackPanel>
            </Grid>

            <!-- Bildirimler: yalnız yapılacak bir şey varken; önizlemeyi aşağı itmez, kendi içinde kayar. -->
            <ScrollViewer x:Name="NoticeScroll" Grid.Row="2" Style="{StaticResource CardScroll}" MaxHeight="150" Margin="{t:Sp '0,s,0,0'}">
                <StackPanel x:Name="Notices">
                    <!-- Sessizlik nedeni ("Sorun Var"): görüntü durdu, menü açık, oyunun altyazısı kapalı. -->
                    <c:Card x:Name="ProblemCard" Kind="Experimental" Visibility="Collapsed">
                        <StackPanel>
                            <c:Chip x:Name="SilentFor" Tone="Live" HorizontalAlignment="Left" />
                            <TextBlock x:Name="ProblemTitle" Style="{StaticResource HeadlineText}" Margin="{t:Sp '0,xs,0,0'}" TextWrapping="Wrap" />
                            <TextBlock x:Name="ProblemText" Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,0'}" />
                            <WrapPanel x:Name="ProblemFixes" Margin="{t:Sp '0,s,0,0'}" />
                        </StackPanel>
                    </c:Card>

                    <!-- Önceki çalışma yerel bir hatayla kapandı: kayıt yalnız bu bilgisayarda, bir kez bildirilir -->
                    <c:Card x:Name="CrashCard" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{t:T 'CouchSubs closed unexpectedly last time.'}" FontWeight="SemiBold" />
                            <TextBlock Text="{t:T 'A crash record was saved on this computer. It stays here and is never sent anywhere on its own; you can add it when you report the problem.'}"
                                       Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,0'}" />
                            <WrapPanel Margin="{t:Sp '0,xs,0,0'}">
                                <Button Content="{t:T 'Show crash record'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,xs,0'}" Click="OnShowCrash" />
                                <Button x:Name="CrashCopyButton" Content="{t:T 'Copy summary'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,xs,0'}" Click="OnCopyCrash" />
                                <Button Content="{t:T 'Close'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,0,0'}" Click="OnDismissCrash" />
                            </WrapPanel>
                        </StackPanel>
                    </c:Card>

                    <!-- Kurulum bitmeden de uygulama örnek görüntülerle denenebilir. -->
                    <local:DemoModeButton x:Name="DemoButton" ButtonStyle="OutlineButton" HorizontalAlignment="Left" Margin="{t:Sp '0,0,0,s'}" Visibility="Collapsed" />

                    <!-- Konsol: Xbox girişi eksik ya da oturum yeniden denemeyi bıraktı (ReconnectOffer). -->
                    <c:Card x:Name="ConsoleCard" Visibility="Collapsed" Title="{Binding ConsoleTitle}">
                        <StackPanel>
                            <TextBlock Text="{Binding Ps5StatusText}" Style="{StaticResource HintText}" />
                            <WrapPanel Margin="{t:Sp '0,xs,0,0'}">
                                <Button Content="{Binding XboxLinkTitle}" Click="OnLinkXbox" Style="{StaticResource PrimaryButton}" Margin="{t:Sp '0,0,xs,0'}"
                                        Visibility="{Binding NeedsXboxLink, Converter={StaticResource VisibleIf}}" />
                                <Button Content="{t:T 'Connect Again'}" Click="OnReconnect" Style="{StaticResource OutlineButton}"
                                        Visibility="{Binding OffersReconnect, Converter={StaticResource VisibleIf}}" />
                            </WrapPanel>
                        </StackPanel>
                    </c:Card>

                    <!-- TV: bağlanmadı, uygulaması eski ya da kaldırıldı; değiştirme ve yeniden kurma burada. -->
                    <c:Card x:Name="TvCard" Title="TV" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{Binding TvStatusText}" Style="{StaticResource HintText}" />
                            <StackPanel Visibility="{Binding ShowTvOpenHint, Converter={StaticResource VisibleIf}}">
                                <TextBlock Text="{Binding TvOpenHintText}" Style="{StaticResource HintText}" Margin="{t:Sp '0,xs,0,0'}" />
                                <TextBlock Text="{Binding TvOpenReasonText}" Style="{StaticResource ErrorText}" Margin="{t:Sp '0,xs,0,0'}"
                                           Visibility="{Binding HasTvOpenReason, Converter={StaticResource VisibleIf}}" />
                                <Button Content="{t:T 'Open the TV App'}" Style="{StaticResource PrimaryButton}" Margin="{t:Sp '0,s,0,0'}" Click="OnRetryTvOpen" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,xs,0,0'}"
                                       Text="{t:T 'The test subtitle did not reach the TV because the TV app is not connected. Open CouchSubs on the TV. If the TV shows a 6-digit code, don\'t type it anywhere: approve it in the “Pair this TV?” window that opens on this computer, then test again.'}"
                                       Visibility="{Binding ShowTestTvHint, Converter={StaticResource VisibleIf}}" />
                            <WrapPanel Margin="{t:Sp '0,xs,0,0'}">
                                <Button Content="{t:T 'Connect TV'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,xs,0'}" Click="OnConnectTv"
                                        Visibility="{Binding NeedsTv, Converter={StaticResource VisibleIf}}" />
                                <Button Content="{t:T 'Connect TV'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,xs,0'}" Click="OnConnectTv"
                                        Visibility="{Binding CanReconnectTv, Converter={StaticResource VisibleIf}}" />
                                <Button Content="{t:T 'Update the TV App'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,xs,0'}" Click="OnUpdateTvApp"
                                        Visibility="{Binding ShowTvAppUpdate, Converter={StaticResource VisibleIf}}" />
                                <Button Content="{t:T 'Reinstall the TV App'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,xs,0'}" Click="OnReinstallTvApp"
                                        Visibility="{Binding CanReinstallTvApp, Converter={StaticResource VisibleIf}}" />
                                <Button Content="{t:T 'Change the TV'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,xs,0'}" Click="OnConnectTv"
                                        Visibility="{Binding CanChangeTv, Converter={StaticResource VisibleIf}}" />
                            </WrapPanel>
                            <StackPanel Visibility="{Binding TvAppUpdating, Converter={StaticResource VisibleIf}}">
                                <s:TvAppCard Margin="{t:Sp '0,s,0,0'}" />
                                <Button Content="{t:T 'Close'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,xs,0,0'}"
                                        Click="OnDismissTvAppUpdate" Visibility="{Binding ShowTvAppUpdateDone, Converter={StaticResource VisibleIf}}" />
                            </StackPanel>
                        </StackPanel>
                    </c:Card>

                    <!-- Oyunun kayıtlı alanları: uygulandı ("Geri al") ya da paketten tanınan oyunda soru ("Kullan" / "Hayır") -->
                    <c:Card x:Name="AreaProfileRow" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="AreaProfileText" Style="{StaticResource HintText}" />
                            <StackPanel Orientation="Horizontal" Margin="{t:Sp '0,xs,0,0'}">
                                <Button x:Name="AreaProfileUse" Content="{t:T 'Use'}" Style="{StaticResource OutlineButton}" Click="OnUseAreaProfile" />
                                <Button x:Name="AreaProfileNo" Content="{t:T 'No'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp 'xs,0,0,0'}" Click="OnDeclineAreaProfile" />
                                <Button x:Name="AreaProfileUndo" Content="{t:T 'Undo'}" Style="{StaticResource OutlineButton}" Click="OnUndoAreaProfile" />
                            </StackPanel>
                        </StackPanel>
                    </c:Card>

                    <!-- PS5 ya da TV uzun süredir bağlanamıyor ve güvenlik duvarında izin yok -->
                    <local:FirewallCard />

                    <!-- Çeviri modeli eksik -->
                    <c:Card x:Name="ModelCard" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{t:T 'The translation model is not downloaded yet.'}" FontWeight="SemiBold" Foreground="{DynamicResource liveTextBrush}" />
                            <StackPanel Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}}" Margin="{t:Sp '0,s,0,0'}">
                                <TextBlock Text="{t:T 'Downloading…'}" Style="{StaticResource HintText}" Margin="{t:Sp '0,0,0,xs'}" />
                                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ModelProgress, Mode=OneWay}" />
                            </StackPanel>
                            <Button Content="{t:T 'Download the model'}" Style="{StaticResource OutlineButton}" Margin="{t:Sp '0,s,0,0'}" Click="OnDownload"
                                    Visibility="{Binding ModelDownloading, Converter={StaticResource VisibleIf}, ConverterParameter=invert}" />
                        </StackPanel>
                    </c:Card>

                    <c:Card Visibility="{Binding GpuFallbackWarning, Converter={StaticResource VisibleIf}}">
                        <TextBlock Style="{StaticResource HintText}" Foreground="{DynamicResource liveTextBrush}"
                                   Text="{t:T 'GPU could not be used; free translation is running on CPU.'}" />
                    </c:Card>
                    <!-- Ücretsiz çeviri motoru bu bilgisayarda açılamadı: çevrimiçi motor önerilir -->
                    <c:Card x:Name="EngineCard" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="{t:T 'The free translation engine could not start on this computer.'}" FontWeight="SemiBold" Foreground="{DynamicResource liveTextBrush}" />
                            <TextBlock Text="Çeviri sekmesinden Gemini (ücretsiz) ya da DeepL seç." Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,s'}" />
                            <Button Content="Çeviri" Style="{StaticResource OutlineButton}" Click="OnTranslationSettings" />
                        </StackPanel>
                    </c:Card>

                    <!-- Çevrimiçi motor çeviremiyor: satırlar bu arada ücretsiz çeviriyle geliyor -->
                    <c:Card x:Name="OnlineCard" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="OnlineTitle" FontWeight="SemiBold" Foreground="{DynamicResource liveTextBrush}" />
                            <TextBlock x:Name="OnlineReason" Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,0'}" />
                        </StackPanel>
                    </c:Card>

                    <!-- Yazı tanıma dili eksik -->
                    <c:Card Visibility="{Binding OcrMissing, Converter={StaticResource VisibleIf}}">
                        <StackPanel>
                            <TextBlock Text="{t:T 'Text recognition for the game language is not installed on this computer.'}" FontWeight="SemiBold" Foreground="{DynamicResource liveTextBrush}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,s'}"
                                       Text="{t:T 'Without it Windows reads the subtitles with your system language and the translation turns into nonsense. Install it once; Windows asks for permission.'}" />
                            <WrapPanel>
                                <Button x:Name="InstallOcr" Content="{t:T 'Install text recognition'}" Style="{StaticResource OutlineButton}" Click="OnInstallOcr" Margin="{t:Sp '0,0,xs,xs'}" />
                                <Button Content="{t:T 'Open Language and Region'}" Style="{StaticResource OutlineButton}" Click="OnLanguageSettings" Margin="{t:Sp '0,0,0,xs'}" />
                            </WrapPanel>
                        </StackPanel>
                    </c:Card>

                    <!-- Kısa ipuçları: ana hesap, otomatik ekran yazısı -->
                    <c:Card>
                        <c:Card.Style>
                            <Style TargetType="c:Card" BasedOn="{StaticResource {x:Type c:Card}}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowsMainAccountTip}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                    <DataTrigger Binding="{Binding ShowsAutoScreenTextNotice}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </c:Card.Style>
                        <StackPanel>
                            <!-- Çeviri PS5'ten (ikinci hesap) okunurken: kolu açınca ana hesap seçilmeli (GitHub #231). -->
                            <TextBlock Style="{StaticResource HintText}"
                                       Text="{t:T 'To play without the connection dropping: 1. On the PS5, start the game with your MAIN account first. 2. Then start translating. 3. Don\'t switch users during the game; when you turn on the controller, choose your MAIN account. Don\'t play with the second account CouchSubs signs in with, or the controller will turn off by itself or won\'t work in the game.'}"
                                       Visibility="{Binding ShowsMainAccountTip, Converter={StaticResource VisibleIf}}" />
                            <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,xxs,0,0'}"
                                       Text="{t:T 'Automatic on-screen text translation is experimental; you can turn it on in Settings.'}"
                                       Visibility="{Binding ShowsAutoScreenTextNotice, Converter={StaticResource VisibleIf}}" />
                        </StackPanel>
                    </c:Card>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ───── Döküm ───── -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource borderBrush}" BorderThickness="1,0,0,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="{t:Sp 'cue,m,cue,s'}">
                    <TextBlock x:Name="FeedCount" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource mutedBrush}" TextWrapping="NoWrap" VerticalAlignment="Bottom" />
                    <TextBlock Text="Döküm" Style="{StaticResource MonoLabel}" VerticalAlignment="Bottom" AutomationProperties.HeadingLevel="Level2" />
                </DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0">
                    <Button Style="{StaticResource LinkButton}" Click="OnHistory" Margin="{t:Sp 'cue,item'}" HorizontalAlignment="Left"
                            Content="Tüm geçmiş ve düzeltmeler →" FocusVisualStyle="{StaticResource FocusRing}" />
                </Border>
                <Grid>
                    <TextBlock x:Name="FeedEmpty" Style="{StaticResource HintText}" Margin="{t:Sp 'cue,s'}"
                               Text="Çeviri başlayınca satırlar burada akar: İngilizcesi, Türkçesi ve nereden geldiği." />
                    <ScrollViewer x:Name="FeedScroll" Style="{StaticResource CardScroll}">
                        <ItemsControl x:Name="Feed" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Cue" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="{t:Sp 'cue,s'}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock x:Name="Label" DockPanel.Dock="Right" Text="{Binding Label}" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource mutedBrush}" TextWrapping="NoWrap" />
                                                <TextBlock x:Name="Time" Text="{Binding Timecode}" Style="{StaticResource Timecode}" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding English}" FontSize="13" Foreground="{DynamicResource mutedBrush}" TextWrapping="Wrap" Margin="{t:Sp '0,xxs,0,0'}" />
                                            <TextBlock x:Name="Turkish" Text="{Binding Turkish}" FontSize="15" Foreground="{DynamicResource textBrush}" TextWrapping="Wrap"
                                                       Margin="{t:Sp '0,line,0,0'}" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding OnScreen}" Value="True">
                                            <Setter TargetName="Cue" Property="Background" Value="{DynamicResource surfaceBrush}" />
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource amberTextBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                            <Setter TargetName="Time" Property="Foreground" Value="{DynamicResource amberTextBrush}" />
                                            <Setter TargetName="Turkish" Property="Foreground" Value="{DynamicResource amberTextBrush}" />
                                            <Setter TargetName="Turkish" Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Fast">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource warnBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Yours">
                                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource textBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>

        <!-- "Hangi Oyunu Oynuyorsunuz?": ana ekran soluklaşır, ortada 560 genişlikte kart; arama, kapak rafı, "Listede Yok" ve "Sorma". -->
        <Grid x:Name="GameAsk" Visibility="Collapsed" Background="{DynamicResource scrimBrush}">
            <Border Style="{StaticResource RaisedBorder}" Width="560" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{t:T 'Game being played'}" Style="{StaticResource MonoLabel}" />
                    <TextBlock Text="{t:T 'Which Game Are You Playing?'}" Style="{StaticResource TitleText}" Margin="{t:Sp '0,xs,0,m'}" />
                    <Grid>
                        <TextBox x:Name="GameSearch" TextChanged="OnGameSearch" KeyDown="OnGameSearchKey" AutomationProperties.Name="{t:T 'Search Games'}" />
                        <TextBlock x:Name="GameSearchHint" Text="{t:T 'Search Games'}" Foreground="{DynamicResource textTertiaryBrush}" Margin="{t:Sp 'm,0,0,0'}"
                                   VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <TextBlock Text="{t:T 'Suggestions'}" Style="{StaticResource MonoLabel}" Margin="{t:Sp '0,m,0,0'}" />
                    <ScrollViewer x:Name="GameShelf" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                                  PreviewMouseWheel="OnShelfWheel">
                        <StackPanel x:Name="GameList" Orientation="Horizontal" Margin="{t:Sp 'xxs,s'}" />
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource HintText}" Margin="{t:Sp '0,xs,0,0'}"
                               Text="{t:T 'Lines not in a pack go to the shared pool with the game\'s name, so a ready translation for that game arrives sooner.'}" />
                    <UniformGrid Rows="1" Margin="{t:Sp '0,m,0,0'}">
                        <Button x:Name="GameCustom" Content="{t:T 'Not in the List'}" HorizontalAlignment="Stretch" Margin="{t:Sp '0,0,xxs,0'}" Click="OnCustomGame" />
                        <Button Content="{t:T 'Don\'t Ask'}" HorizontalAlignment="Stretch" Margin="{t:Sp 'xxs,0,0,0'}" Click="OnDontAskGame" />
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
