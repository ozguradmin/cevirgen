<!-- İlk açılış (taslak: design/cevirgen/arayuz-taslagi/Setup.dc.html): tek soru, dört cevap. "Oyunu nerede oynuyorsun?":
     PS5, Xbox, Bilgisayar, Diğer; her seçenek nasıl çalıştığını, neye ihtiyaç duyduğunu ve kurulumun kaç adım olduğunu söyler.
     Seçili seçenek yükseltilmiş zemin ve üstte 3 px sarı çizgi. Devam seçimi uygular; sihirbaz yalnız o platformun adımlarından
     geçer. Altta anonim kullanım sayımının açıklaması ve anahtarı (KVKK; ilk açılışta bir kez gösterilir). -->
<UserControl x:Class="CouchSubs.App.Views.Steps.WelcomeStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:CouchSubs.App.Controls"
             xmlns:t="clr-namespace:CouchSubs.App.Theme">
    <UserControl.Resources>
        <!-- Platform seçeneği (taslak: radiogroup içindeki düğme). -->
        <Style x:Key="PlatformOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="platform" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="{DynamicResource textBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource borderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Cell" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Border x:Name="Mark" Height="3" VerticalAlignment="Top" Background="{DynamicResource amberBrush}" Visibility="Collapsed" />
                                <ContentPresenter Margin="{t:Sp 'l'}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource surfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource fieldBrush}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Oyunu nerede oynuyorsun?" Style="{StaticResource ScreenTitle}" FontSize="44" TextWrapping="Wrap"
                   AutomationProperties.HeadingLevel="Level1" />
        <TextBlock Style="{StaticResource SecondaryText}" FontSize="17" MaxWidth="640" HorizontalAlignment="Left" Margin="{t:Sp '0,xs,0,0'}"
                   LineHeight="25" LineStackingStrategy="BlockLineHeight"
                   Text="Çevirgen ekrandaki İngilizce altyazıyı okuyup Türkçesini gösterir; altyazısı olan her oyunda çalışır. Kurulum seçimine göre ilerler, sonra Ayarlar'dan değiştirebilirsin." />
        <Border BorderBrush="{DynamicResource borderBrush}" BorderThickness="1" Margin="{t:Sp '0,l,0,0'}">
            <UniformGrid x:Name="Options" Rows="1" AutomationProperties.Name="Platform" />
        </Border>
        <!-- Anonim kullanım sayımı: ne gönderildiği düz yazıyla açıkça yazılır; anahtar yalnız Ayarlar › Uygulama › Gizlilik'te. -->
        <TextBlock x:Name="CountNote" FontSize="13" Foreground="{DynamicResource mutedBrush}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left"
                   Margin="{t:Sp '0,m,0,0'}" LineHeight="19" LineStackingStrategy="BlockLineHeight" />
    </StackPanel>
</UserControl>
