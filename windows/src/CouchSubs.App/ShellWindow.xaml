<!-- Çevirgen kabuğu (taslak: design/cevirgen/arayuz-taslagi/Main.dc.html): en üstte tam genişlikte sarı güncelleme şeridi
     (yalnız yeni sürüm varken), duyuru çubuğu (sunucudan, kapatılabilir), sonra 64 yükseklikte üst çubuk: solda "çevirgen"
     adı, düz yazı sekmeler (Canlı · Görünüm · Çeviri · Geçmiş ve sözlük · Ayarlar; seçili sekme beyaz + 2 px sarı alt çizgi),
     sağda kısa cihaz durumu (nokta + kaynak / TV / motor) ve çeviriyi başlat/durdur. Altta reklam bandı. Kıl çizgiler, gölge
     yok. Kurulumda üst çubuk ve reklam yok (sihirbazın kendi çubuğu var). En küçük boy 1200 × 760. -->
<Window x:Class="CouchSubs.App.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:CouchSubs.App.Controls"
        xmlns:t="clr-namespace:CouchSubs.App.Theme"
        Title="Çevirgen" Icon="Assets/Cevirgen.ico"
        Width="{DynamicResource size.windowWidth}" Height="{DynamicResource size.windowHeight}"
        Background="{DynamicResource windowBackgroundBrush}" Foreground="{DynamicResource textPrimaryBrush}"
        TextElement.Foreground="{DynamicResource textPrimaryBrush}" WindowStartupLocation="CenterScreen">
    <DockPanel x:Name="Root" LastChildFill="True">
        <!-- Yeni sürüm: tam genişlikte sarı şerit (CouchSubs'taki gibi göze çarpar). -->
        <Border x:Name="UpdateBanner" DockPanel.Dock="Top" Background="#FFD23F" Visibility="Collapsed" TextElement.Foreground="#0F1014">
            <StackPanel Margin="{t:Sp 'edge,s'}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="{t:Sp 'm,0,0,0'}">
                        <Button x:Name="UpdateNotesToggle" Style="{StaticResource TextLink}" Foreground="#0F1014" Content="Sürüm notları"
                                Click="OnUpdateNotes" Margin="{t:Sp '0,0,m,0'}" />
                        <Button x:Name="UpdateButton" Style="{StaticResource OnAmberButton}" Click="OnUpdate" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" FontSize="15" FontWeight="Bold" Foreground="#0F1014" TextWrapping="Wrap" />
                        <TextBlock x:Name="UpdateHintText" FontSize="13" Foreground="#0F1014" Margin="{t:Sp '0,line,0,0'}" Visibility="Collapsed" />
                        <ProgressBar x:Name="UpdateBar" Minimum="0" Maximum="1" Height="4" Margin="{t:Sp '0,xs,0,0'}" Visibility="Collapsed"
                                     Foreground="#0F1014" Background="#33000000" MaxWidth="480" HorizontalAlignment="Left" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="UpdateNotes" MaxHeight="180" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="{t:Sp '0,s,0,0'}">
                    <TextBlock x:Name="UpdateNotesText" FontSize="13" Foreground="#0F1014" TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Duyuru (Çevirgen sunucusundan): mono etiket, metin, isteğe bağlı "Aç" bağlantısı ve kapat. -->
        <Border x:Name="AnnouncementBar" DockPanel.Dock="Top" Background="{DynamicResource fieldBrush}" BorderBrush="{DynamicResource borderBrush}"
                BorderThickness="0,0,0,1" Visibility="Collapsed">
            <DockPanel Margin="{t:Sp 'edge,0'}" MinHeight="44">
                <Button x:Name="AnnouncementClose" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Width="44" MinHeight="44" Padding="0"
                        Click="OnDismissAnnouncement" AutomationProperties.Name="Duyuruyu kapat" ToolTip="Duyuruyu kapat">
                    <TextBlock Text="&#xE711;" Style="{StaticResource GlyphText}" FontSize="12" />
                </Button>
                <Button x:Name="AnnouncementOpen" DockPanel.Dock="Right" Style="{StaticResource TextLink}" Content="Aç →" Click="OnOpenAnnouncement"
                        Margin="{t:Sp 'm,0'}" />
                <TextBlock Text="Duyuru" Style="{StaticResource MonoLabel}" Foreground="{DynamicResource amberTextBrush}" VerticalAlignment="Center"
                           Margin="{t:Sp '0,0,s,0'}" />
                <TextBlock x:Name="AnnouncementText" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" Margin="{t:Sp '0,xs'}" />
            </DockPanel>
        </Border>

        <!-- Üst çubuk -->
        <Border x:Name="TopBar" DockPanel.Dock="Top" MinHeight="{DynamicResource size.header}" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="{t:Sp 'edge,0'}" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Click="OnWordmark" VerticalAlignment="Center" Margin="{t:Sp '0,0,edge,0'}"
                        AutomationProperties.Name="Çevirgen · Canlı">
                    <c:Wordmark />
                </Button>
                <StackPanel x:Name="Tabs" DockPanel.Dock="Left" Orientation="Horizontal" AutomationProperties.Name="Bölümler">
                    <RadioButton x:Name="HomeTab" Style="{StaticResource ShellTab}" Content="Canlı" Checked="OnTab" IsChecked="True" />
                    <RadioButton x:Name="AppearanceTab" Style="{StaticResource ShellTab}" Content="Görünüm" Checked="OnTab" />
                    <RadioButton x:Name="TranslationTab" Style="{StaticResource ShellTab}" Content="Çeviri" Checked="OnTab" />
                    <RadioButton x:Name="HistoryTab" Style="{StaticResource ShellTab}" Content="Geçmiş ve sözlük" Checked="OnTab" />
                    <RadioButton x:Name="SettingsTab" Style="{StaticResource ShellTab}" Content="Ayarlar" Checked="OnTab" Margin="0" />
                </StackPanel>
                <!-- Sağ: Ayarlar'da "Kurulumu baştan başlat"; diğer sekmelerde cihaz durumu ve başlat/durdur. -->
                <Button x:Name="RestartSetup" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Kurulumu baştan başlat"
                        VerticalAlignment="Center" Click="OnRestartSetup" Visibility="Collapsed" />
                <StackPanel x:Name="StatusArea" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel x:Name="StatusLine" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Button x:Name="Toggle" MinHeight="44" Padding="{t:Sp 'm,0'}" FontSize="14" Click="OnToggle" Margin="{t:Sp 's,0,0,0'}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <c:AdBand x:Name="Ads" DockPanel.Dock="Bottom" />

        <ContentControl x:Name="Host" Focusable="False" />
    </DockPanel>
</Window>
