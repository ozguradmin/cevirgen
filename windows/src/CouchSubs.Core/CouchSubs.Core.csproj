<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ortak kaynaklar (shared/resources): tasarım değerleri, ekran metinleri, OBS ve ikinci ekran sayfaları. -->
    <EmbeddedResource Include="..\..\..\design\tokens.json" LogicalName="tokens.json" />
    <EmbeddedResource Include="..\..\..\shared\resources\obs-overlay.html" LogicalName="obs-overlay.html" />
    <EmbeddedResource Include="..\..\..\shared\resources\second-screen.html" LogicalName="second-screen.html" />
    <EmbeddedResource Include="..\..\..\shared\resources\glossary-en-tr.json" LogicalName="glossary-en-tr.json" />
    <EmbeddedResource Include="..\..\..\shared\resources\ai-models.json" LogicalName="ai-models.json" />
    <!-- Oyun çeviri paketleri (shared/resources/packs; ad: "packs/x.json.gz"). -->
    <EmbeddedResource Include="..\..\..\shared\resources\packs\*.json.gz" LogicalName="packs/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\..\shared\resources\Localizable.xcstrings" LogicalName="Localizable.xcstrings" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- "Başka bir cihazda göster" adresinin QR kodu (MIT). -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Paket imzasının (PackFuzzy) iç adımları Mac ve betikle aynı mı: ortak deneme verisiyle sınanır. -->
    <InternalsVisibleTo Include="CouchSubs.Core.Tests" />
    <InternalsVisibleTo Include="CouchSubs.Translation.Tests" />
  </ItemGroup>

</Project>
